{
  "name": "@course-building-12-factor-agents/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "client": "tsx src/client/main.ts",
    "build": "tsc && cp -R src/core/prompts dist/core/prompts && cp -R src/core/tools/schemas dist/core/tools/schemas",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^6.42.0"
  }
}
